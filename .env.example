# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# MONGODB_URI: Optional MongoDB connection string for MERN database persistence.
# If omitted, the server operates on an in-memory document store seeded with LBRCE defaults.
# Example: mongodb+srv://username:password@cluster.mongodb.net/lbrce_hostel?retryWrites=true&w=majority
MONGODB_URI="mongodb://localhost:27017/lbrce_hostel"

PORT=3000
